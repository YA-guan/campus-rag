{
  "info": {
    "name": "servlet-mock-demo",
    "description": "Web 环境测试项目接口集合：仅一个写死的查询列表接口，无数据库依赖。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/servlet-mock-demo",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "查询列表（写死数据 / 无数据库）",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/list",
          "host": ["{{baseUrl}}"],
          "path": ["api", "list"]
        },
        "description": "返回代码中写死的列表数据，用于验证 Web 容器环境。"
      },
      "response": []
    }
  ]
}
